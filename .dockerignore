# .dockerignore
# Exclude large directories and build artifacts from Docker context

# Data and outputs (mounted at runtime)
data/
runs/
mlflow/
outputs/

# Version control
.git/
.gitattributes

# Virtual environments
.venv/
.pixi/
node_modules/

# Build artifacts
*.egg-info/
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.ruff_cache/
.pytest_cache/

# IDE
.vscode/
.idea/

# Notebooks (not needed for training)
notebooks/

# macOS
.DS_Store

# Environment files with secrets (mounted at runtime if needed)
.env

# Lock files (deps already in image)
uv.lock
*.lock.txt
*.lock.yml

# Documentation
*.md
!README.md
